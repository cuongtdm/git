# Files are deliberately allow-listed; no request can select an arbitrary path.
LOCAL_RT_BIND=127.0.0.1
LOCAL_RT_PORT=8081
LOCAL_RT_MEDIA_DIR=/opt/vrbt/bin/mediaserver_pcm/media/local
LOCAL_RT_FALLBACK_SONG=song-1.wav
# Set these to the CRBT content database. If lookup fails or no active album
# item exists, LOCAL_RT_FALLBACK_SONG is played.
LOCAL_RT_DB_HOST=127.0.0.1
LOCAL_RT_DB_PORT=3306
LOCAL_RT_DB_NAME=
LOCAL_RT_DB_USER=
LOCAL_RT_DB_PASSWORD=
# Cache active album-item song lists; random selection still happens per call.
# Set to 0 to disable caching. Provisioning changes are visible within this TTL.
LOCAL_RT_PROFILE_CACHE_SECONDS=900
# Bound memory usage for a long-running service with many distinct subscribers.
LOCAL_RT_PROFILE_CACHE_MAX_ENTRIES=1000
LOCAL_RT_MSISDN_PREFIX=509
# NATCOM Request-URI: 1221 + subscriber, e.g. 122143058876 -> 50943058876.
LOCAL_RT_CALLED_ROUTING_PREFIX=1221
