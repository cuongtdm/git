</appender>
<appender name="IPCSERVER_FOR_MEDIA_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="ALL"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/ipcserver_for_media/ipcserver_for_media.log"/>
 <param name="Append" value="true"/>
