<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<!-- Log4j Configuration -->
<!--
| For more configuration infromation and examples see the Jakarta Log4j
| website: http://jakarta.apache.org/log4j
-->
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/" debug="false">

<!-- ============================== -->
<!-- Append messages to the console -->
<!-- ==============================-->
<appender name="CONSOLE" class="org.apache.log4j.ConsoleAppender">
 <param name="Target" value="System.out"/>
 <param name="Threshold" value="OFF"/>
 <layout class="org.apache.log4j.PatternLayout">
  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
</appender>

<!-- Root -->
<!-- Buffer events and log them asynchronously -->
<appender name="ROOT_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="INFO"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/main/main.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
 <layout class="org.apache.log4j.PatternLayout">
  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
</appender>

<!-- alarm -->
<appender name="ALARM_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="ALARM_FILE"/>
</appender>
<appender name="ALARM_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="INFO"/>
 <param name="File" value="/u02/log/error/mediactrl_rt/alarm/alarm.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
 <layout class="org.apache.log4j.PatternLayout">
  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-20c] - %m%n"/>
 </layout>
</appender>

<!-- ROOT category -->
<appender name="ROOT_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="CONSOLE"/>
 <appender-ref ref="ROOT_FILE"/>
 <appender-ref ref="ALARM_FILE"/>
</appender>
<!-- END ROOT category -->

<!-- begin appender for ininterface-->
<!-- 1. call_info_cdr -->
<appender name="CDR_CALL_INFO_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="CDR_CALL_INFO_FILE"/>
</appender>

<appender name="CDR_CALL_INFO_FILE" class="com.elcom.log4j.ExportingFileAppender">
 <param name="Threshold" value="ALL" />
 <param name="File" value="/u02/cdr/mediactrl_rt/core01_call.exporting" />
 <param name="DatePattern" value=".yyyyMMddHHmmssSSS" />
 <param name="IndexPattern" value=".%03d" />
 <param name="RolledPeriodMillis" value="6000" />
 <param name="MaxRecord" value="10000" />
 <param name="RolledFileNamePattern" value="core01_%d%i.cdr" />
 <param name="RolledFolderDatePattern" value="yyyyMMdd" />
 <param name="AutoDeleteEmptyFile" value="true" />
</appender>

<appender name="MAIN_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="MAIN_FILE"/>
</appender>
<appender name="MAIN_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="INFO"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/main/main.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
 <layout class="org.apache.log4j.PatternLayout">
  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
</appender>
<appender name="CCU_FILE" class="com.elcom.log4j.ExportingFileAppender">
 <param name="Threshold" value="ALL" />
 <param name="File" value="/u02/cdr/export/mediactrl_rt/ccu/core01_ccu.cdr" />
 <param name="DatePattern" value=".yyyyMMdd_HHmmssSSS" />
 <param name="IndexPattern" value=".%03d" />
 <param name="RolledPeriodMillis" value="600000" />
 <param name="MaxRecord" value="10000" />
 <param name="RolledFileNamePattern" value="core01_ccu%d%i.cdr" />
 <param name="RolledFolderDatePattern" value="yyyyMMdd" />
 <param name="AutoDeleteEmptyFile" value="true" />
</appender>

<appender name="CPS_FILE" class="com.elcom.log4j.ExportingFileAppender">
 <param name="Threshold" value="ALL" />
 <param name="File" value="/u02/cdr/export/mediactrl_rt/cps/core01_cps.cdr" />
 <param name="DatePattern" value=".yyyyMMdd_HHmmssSSS" />
 <param name="IndexPattern" value=".%03d" />
 <param name="RolledPeriodMillis" value="600000" />
 <param name="MaxRecord" value="10000" />
 <param name="RolledFileNamePattern" value="core01_cps%d%i.cdr" />
 <param name="RolledFolderDatePattern" value="yyyyMMdd" />
 <param name="AutoDeleteEmptyFile" value="true" />
</appender>
<appender name="FLOW_EXPIRE_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="FLOW_EXPIRE_FILE"/>
</appender>
<appender name="FLOW_EXPIRE_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="INFO"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/flow_expire/flow_expire.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
 <layout class="org.apache.log4j.PatternLayout">
  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
</appender>

<appender name="IPCCLIENT_TO_SWAPFILE_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="IPCCLIENT_TO_SWAPFILE_FILE"/>
</appender>
<appender name="IPCCLIENT_TO_SWAPFILE_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="INFO"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/main/main.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
 <layout class="org.apache.log4j.PatternLayout">
  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
</appender>

<appender name="PROCESSING_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="PROCESSING_FILE"/>
</appender>
<appender name="PROCESSING_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="ALL"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/processing/processing.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
 <layout class="org.apache.log4j.PatternLayout">
  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
