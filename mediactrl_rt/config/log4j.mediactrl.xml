  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
</appender>

<appender name="RT_CLIENT_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="RT_CLIENT_FILE"/>
</appender>
<appender name="RT_CLIENT_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="ALL"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/main/main.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
 <layout class="org.apache.log4j.PatternLayout">
  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
</appender>

<appender name="APS_CLIENT_ASYNC" class="org.apache.log4j.AsyncAppender">
 <appender-ref ref="APS_CLIENT_FILE"/>
</appender>
<appender name="APS_CLIENT_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="ALL"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/main/main.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
 <layout class="org.apache.log4j.PatternLayout">
