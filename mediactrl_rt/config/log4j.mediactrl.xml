  <param name="ConversionPattern" value="[%-5p] - [%-23d{ISO8601}] - [%-16t] - %m%n"/>
 </layout>
</appender>

<category name="call_info_cdr" additivity="false"> 
 <appender-ref ref="CDR_CALL_INFO_ASYNC"/> 
</category>
<category name="ccu_cdr" additivity="false"> 
 <appender-ref ref="CCU_FILE"/> 
</category>

<category name="cps_cdr" additivity="false"> 
 <appender-ref ref="CPS_FILE"/> 
</category>
<category name="main" additivity="false"> 
 <appender-ref ref="MAIN_FILE"/> 
 <appender-ref ref="ALARM_ASYNC"/>
</category>

<category name="ipcclient_to_swapfile" additivity="false"> 
 <appender-ref ref="IPCCLIENT_TO_SWAPFILE_ASYNC"/>
 <appender-ref ref="ALARM_ASYNC"/>
</category>

<category name="processing" additivity="false"> 
 <appender-ref ref="PROCESSING_ASYNC"/>
 <appender-ref ref="ALARM_ASYNC"/>
</category>

<category name="ipcserver_for_media" additivity="false"> 
 <appender-ref ref="IPCSERVER_FOR_MEDIA_ASYNC"/>
 <appender-ref ref="ALARM_ASYNC"/>
</category>

<category name="rt_client" additivity="false"> 
 <appender-ref ref="RT_CLIENT_ASYNC"/>
 <appender-ref ref="ALARM_ASYNC"/>
</category>

<category name="aps_client" additivity="false"> 
 <appender-ref ref="APS_CLIENT_ASYNC"/>
 <appender-ref ref="ALARM_ASYNC"/>
</category>

<category name="flow_expire" additivity="false"> 
 <appender-ref ref="PROCESSING_ASYNC"/>
 <appender-ref ref="FLOW_EXPIRE_ASYNC"/>
 <appender-ref ref="ALARM_ASYNC"/>
</category>

<category name="org.apache.commons.httpclient" additivity="false"> 
 <appender-ref ref="APACHE_HTTP_CLIENT_ASYNC"/>
</category>

<!-- Setup the Root category -->
<root>
 <appender-ref ref="ROOT_ASYNC"/>
</root>
</log4j:configuration>
