<appender name="APACHE_HTTP_CLIENT_ASYNC" class="org.apache.log4j.AsyncAppender">
<appender-ref ref="APACHE_HTTP_CLIENT_FILE"/>
</appender>
<appender name="APACHE_HTTP_CLIENT_FILE" class="org.apache.log4j.DailyRollingFileAppender">
 <param name="Threshold" value="ALL"/>
 <param name="File" value="/opt/vrbt/log/mediactrl_rt/main/main.log"/>
 <param name="Append" value="true"/>
 <param name="DatePattern" value=".yyyyMMdd_HH"/>
